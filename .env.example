# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL & SUPABASE_PUBLISHABLE_KEY: Required for Supabase cloud database, Auth, Realtime & Storage.
# Configure SUPABASE_PUBLISHABLE_KEY via the Secrets panel in AI Studio UI (do NOT use Service Role Key).
SUPABASE_URL=https://fnztmondnvgyrkuctlty.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
